{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../app && npm ci --ignore-scripts",
  "buildCommand": "cd ../app && npm run build:demo",
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/app/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
